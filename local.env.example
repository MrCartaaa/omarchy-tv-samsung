# Copy this file to local.env and fill it in on the computer that talks to
# the television. local.env is gitignored. Do not commit addresses.
#
# TV_ADDR is the television on the LAN.
# BIND_HOST is this computer's LAN address, the same address developer mode
# lists.
# SDB_BIN is Samsung's sdb binary.
# TIZENPWN is a checkout of https://github.com/rackrot/tizenpwn at the commit
# named in the README.

TV_ADDR=
BIND_HOST=
SDB_BIN=
TIZENPWN=
