# Copy this file to daemon/settle.env and fill it in on the computer that
# will keep the lists applied. settle.env is not committed.
#
# TV_ADDR is the television on the LAN. Developer mode on the TV must name
# this computer.
# BIND_HOST is this computer's LAN address, the same address developer mode
# lists. The settle command calls back to that address.
# SDB_BIN is Samsung's sdb binary. Tizen Studio ships it under tools/sdb.
# TIZENPWN is a checkout of https://github.com/rackrot/tizenpwn at the commit
# named in the README. settle imports that checkout's SDB client only when a
# package has come back.

TV_ADDR=
TV_PORT=26101
BIND_HOST=
SDB_BIN=
TIZENPWN=
